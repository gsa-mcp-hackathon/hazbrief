# ─── MCP Transport ────────────────────────────────────────────────────────────
# "stdio"           — local subprocess (Claude Desktop / Claude Code / Zed)
# "streamable-http" — remote HTTP server (containers, cloud deploys)
#
# On a cloud host (IBM Code Engine, Databricks Apps) you usually leave this as
# stdio: app.py automatically switches to HTTP when the platform injects a port
# (DATABRICKS_APP_PORT or PORT).
MCP_TRANSPORT=stdio

# ─── HTTP Server (only used when running over HTTP) ───────────────────────────
# MCP_HOST defaults to 127.0.0.1 (src/hazbrief/config.py): the HTTP route has no
# authentication and no rate limit (docs/SECURITY.md, HB-89). Widen it (0.0.0.0) only inside
# a container or behind an authenticating gateway. It is not set here because a value in this
# file overrides the image's own: `docker run --env-file .env` would carry it over the
# Dockerfile's MCP_HOST=0.0.0.0, the server would bind the container's loopback and the
# published port would reach nothing (Issue 260116a9, HB-201; fixed by HB-197).
# MCP_HOST=127.0.0.1
# MCP_TRANSPORT and MCP_PORT do not override the image: app.py serves HTTP on PORT, which the
# Dockerfile sets to 8080, before it reads either of them.
MCP_PORT=8000
# Host header names accepted beyond 127.0.0.1, localhost and ::1, as a JSON list
# (e.g. ["hazbrief.example.gov"]). Blank: loopback only.
MCP_ALLOWED_HOSTS=

# ─── Outbound identity (DN-002 section 1) ─────────────────────────────────────
# The contact URL in the User-Agent every upstream call sends
# (hazbrief-mcp/<version> (+<url>)). The NWS API requires a User-Agent with a contact.
HAZBRIEF_CONTACT_URL=https://github.com/brockwebb/hazbrief-mcp

# ─── Upstream endpoints (HB-K1, HB-08; src/hazbrief/config.py) ────────────────
# The origin of each API the tools call, and the limits on every call.
NWS_API_BASE_URL=https://api.weather.gov/
# facilities_in_footprint (HB-10): USGS Structures, USGS 3DHP, BTS NTAD rail.
USGS_STRUCTURES_BASE_URL=https://carto.nationalmap.gov/arcgis/rest/services/
USGS_3DHP_BASE_URL=https://hydro.nationalmap.gov/arcgis/rest/services/
BTS_NTAD_BASE_URL=https://services.arcgis.com/xOi1kZaI0eWDREZv/ArcGIS/rest/services/
UPSTREAM_TIMEOUT_SECONDS=30
UPSTREAM_MAX_RESPONSE_BYTES=5000000

# ─── Recorded exchanges (DN-005 section 2) ────────────────────────────────────
# live: call upstream APIs. record: write each exchange that has no file (fixture recording;
# scripts/record_nws_fixtures.py sets it). replay: serve only recorded exchanges (the test
# suite's default, set by tests/conftest.py).
HAZBRIEF_HTTP_MODE=live
# Where exchanges are recorded and replayed from; blank means fixtures/exchanges/ at the root.
HAZBRIEF_EXCHANGES_DIR=
# Where scripts/fetch_cms.py caches the CMS hospital and nursing home files; blank means
# fixtures/cms/ at the root (HB-10).
HAZBRIEF_CMS_DIR=

# ─── Footprint geometry (DN-005 section 4) ────────────────────────────────────
# Vertices of each zone circle's polygon.
FOOTPRINT_CIRCLE_VERTICES=72

# ─── Dataset API keys (HB-06; corpus/api_catalog.yaml) ────────────────────────
# Never commit the filled-in .env.
#
# Census Data API key: REQUIRED for every data query since May 2026.
# Sign up: https://api.census.gov/data/key_signup.html (key arrives by email; click its
# activation link; the address must end .com, .net, .org, .gov or .edu).
CENSUS_API_KEY=

# ─── The application (the workbench and `hazbrief brief`), never the server ───
# Read by src/hazbrief/brief/settings.py only; the server never reads it and its
# container never needs it (DN-012 section 3, HB-45). OPTIONAL: without it the map is
# Leaflet over the USGS National Map tiles. A browser key, written into the brief the CLI
# builds: restrict it by HTTP referrer.
# Get one: https://developers.google.com/maps/documentation/javascript/get-api-key
GOOGLE_MAPS_API_KEY=
