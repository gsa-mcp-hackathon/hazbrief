  "Correlation": {
   "additionalProperties": false,
   "description": "A temperature correlation as the held page prints it: `form` states the equation\nand its units in the page's terms; `rows` are every printed row (Antoine) or the\nlowest-temperature column (Shomate), each with its range. A source term picks the\nrow whose range covers its temperature; none is extrapolated here.",
   "properties": {
    "form": {
     "title": "Form",
     "type": "string"
    },
    "reason": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Reason"
    },
    "rows": {
     "default": [],
     "items": {
      "$ref": "#/$defs/CorrelationRow"
     },
     "title": "Rows",
     "type": "array"
    },
    "status": {
     "enum": [
      "held",
      "not_applicable",
      "not_held"
     ],
     "title": "Status",
     "type": "string"
    }
   },
   "required": [
    "form",
    "status"
   ],
   "title": "Correlation",
   "type": "object"
  },
  "CorrelationRow": {
   "additionalProperties": false,
   "description": "One printed row of a correlation's constants and the temperature range the page\nstates it for; each constant carries the row's receipt.",
   "properties": {
    "constants": {
     "additionalProperties": {
      "$ref": "#/$defs/HeldValue"
     },
     "title": "Constants",
     "type": "object"
    },
    "receipt": {
     "$ref": "#/$defs/ValueReceipt"
    },
    "t_max_k": {
     "title": "T Max K",
     "type": "number"
    },
    "t_min_k": {
     "title": "T Min K",
     "type": "number"
    }
   },
   "required": [
    "t_min_k",
    "t_max_k",
    "constants",
    "receipt"
   ],
   "title": "CorrelationRow",
   "type": "object"
  },
  "CrossCheck": {
   "additionalProperties": false,
   "description": "One field compared across sources (DN-003 section 5). `values` maps each source\nrole to its value as that source prints it, or None where the source does not carry\nthe field. `agree`: every carrying source agrees and at least two carry it;\n`disputed`: two carrying sources differ; `single_source`: only one source carries\nit.",
   "properties": {
    "field": {
     "title": "Field",
     "type": "string"
    },
    "status": {
     "enum": [
      "agree",
      "disputed",
      "single_source"
     ],
     "title": "Status",
     "type": "string"
    },
    "values": {
     "additionalProperties": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "title": "Values",
     "type": "object"
    }
   },
   "required": [
    "field",
    "values",
    "status"
   ],
   "title": "CrossCheck",
   "type": "object"
  },
  "DispersionClassRule": {
   "additionalProperties": false,
