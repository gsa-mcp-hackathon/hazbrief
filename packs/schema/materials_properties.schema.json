{
 "$defs": {
  "AirBasis": {
   "additionalProperties": false,
   "description": "What turns a mass concentration into a volume fraction: the basis ppm and mg/m3\nare converted at (NIOSH: 25 C and 1 atm; EPA's RMP guidance: 25 C is 298 K) and the\nconstants of the U.S. Standard Atmosphere, 1976 (1 atm is its sea-level P0; R* is\nits k times its N_A).",
   "properties": {
    "asphyxiant_vol_pct_at_threshold": {
     "$ref": "#/$defs/HeldValue"
    },
    "avogadro_constant_per_kmol": {
     "$ref": "#/$defs/HeldValue"
    },
    "boltzmann_constant_n_m_k": {
     "$ref": "#/$defs/HeldValue"
    },
    "conversion_pressure_atm": {
     "$ref": "#/$defs/HeldValue"
    },
    "conversion_temperature_c": {
     "$ref": "#/$defs/HeldValue"
    },
    "conversion_temperature_k": {
     "$ref": "#/$defs/HeldValue"
    },
    "gas_constant_j_kmol_k": {
     "$ref": "#/$defs/HeldValue"
    },
    "molar_volume_m3_kmol": {
     "$ref": "#/$defs/HeldValue"
    },
    "oxygen_volume_fraction": {
     "$ref": "#/$defs/HeldValue"
    },
    "standard_pressure_pa": {
     "$ref": "#/$defs/HeldValue"
    }
   },
   "required": [
    "conversion_temperature_c",
    "conversion_pressure_atm",
    "conversion_temperature_k",
    "boltzmann_constant_n_m_k",
    "avogadro_constant_per_kmol",
    "gas_constant_j_kmol_k",
    "standard_pressure_pa",
    "molar_volume_m3_kmol",
    "oxygen_volume_fraction",
    "asphyxiant_vol_pct_at_threshold"
   ],
   "title": "AirBasis",
   "type": "object"
  },
