       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Source Tier"
    },
    "status": {
     "enum": [
      "held",
      "not_applicable",
      "not_held"
     ],
     "title": "Status",
     "type": "string"
    },
    "temperature_k": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Temperature K"
