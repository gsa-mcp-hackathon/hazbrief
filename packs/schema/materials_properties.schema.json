  "ValueReceipt": {
   "additionalProperties": false,
   "description": "Where a value is printed. `page` is the PDF page, or the form-feed block of a\nconverted file (packs/SCHEMA.md, Locators); `quote` is the text as printed there.\n`read_by`: `text_layer` (verified on the page's text at build) or `rendered_page`\n(a page with no usable text layer, read from its image; the quote is the\nreading). `sha256` is the held file's raw sha256, so a receipt names the exact\nbytes it was read from (HB-109; DN-020 section 2 item 4). From a `reference-only`\nsource the quote is the number and its unit only (the licence gate,\npacks/SCHEMA.md).",
   "properties": {
    "doc_id": {
     "title": "Doc Id",
     "type": "string"
    },
    "locator": {
     "title": "Locator",
     "type": "string"
    },
    "page": {
     "title": "Page",
     "type": "integer"
    },
    "quote": {
     "title": "Quote",
     "type": "string"
    },
    "read_by": {
     "default": "text_layer",
     "enum": [
      "text_layer",
      "rendered_page"
     ],
     "title": "Read By",
     "type": "string"
    },
    "sha256": {
     "title": "Sha256",
     "type": "string"
    }
   },
   "required": [
    "doc_id",
    "page",
    "locator",
    "quote",
    "sha256"
   ],
   "title": "ValueReceipt",
   "type": "object"
  }
 },
