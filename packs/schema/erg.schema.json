    },
    "keyed_by": {
     "items": {
      "enum": [
       "A",
       "B",
       "C"
      ],
      "type": "string"
     },
     "title": "Keyed By",
     "type": "array"
    },
    "locator": {
     "title": "Locator",
     "type": "string"
    },
    "name": {
     "title": "Name",
     "type": "string"
    },
    "unresolved": {
     "title": "Unresolved",
     "type": "boolean"
    },
    "unresolved_fields": {
     "items": {
      "type": "string"
     },
     "title": "Unresolved Fields",
     "type": "array"
    }
   },
   "required": [
    "keyed_by",
    "adjudicated",
    "unresolved",
    "unresolved_fields",
    "name",
    "guide",
    "locator"
   ],
   "title": "ErgIndexName",
   "type": "object"
  },
  "ErgMaterial": {
   "additionalProperties": false,
   "description": "Every ID number in the yellow index (schema version 3). `guide` is None when the\nindex prints different guides under different names of the ID (the names carry\ntheirs). `tih`: Table 1 lists the ID. `table2`: its Table 2 rows, or None.\n`where_spilled_matters`: Table 2 lists it, so a spill in water changes the answer\n(ERG pp. 30, 336). `cross_checks` are DN-003 section 5's, for the seed materials.",
   "properties": {
    "cross_checks": {
     "items": {
      "$ref": "#/$defs/CrossCheck"
     },
     "title": "Cross Checks",
     "type": "array"
    },
    "disputed": {
     "title": "Disputed",
     "type": "boolean"
    },
    "guide": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Guide"
    },
    "names": {
     "items": {
      "$ref": "#/$defs/ErgName"
     },
     "title": "Names",
     "type": "array"
    },
    "table1": {
     "items": {
      "$ref": "#/$defs/Table1Entry"
     },
     "title": "Table1",
     "type": "array"
    },
    "table2": {
     "anyOf": [
      {
       "items": {
        "$ref": "#/$defs/Table2Entry"
       },
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "title": "Table2"
    },
    "table3": {
     "anyOf": [
      {
       "$ref": "#/$defs/Table3"
      },
      {
       "type": "null"
      }
     ]
    },
    "tih": {
     "title": "Tih",
     "type": "boolean"
    },
    "un": {
     "title": "Un",
     "type": "string"
    },
    "where_spilled_matters": {
     "title": "Where Spilled Matters",
     "type": "boolean"
    }
   },
   "required": [
    "un",
    "names",
    "guide",
    "tih",
    "table1",
    "table2",
    "where_spilled_matters",
    "table3",
    "cross_checks",
    "disputed"
   ],
