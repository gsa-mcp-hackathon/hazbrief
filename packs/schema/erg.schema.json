  "ErgNameAlias": {
   "additionalProperties": false,
   "description": "Another name for a yellow-index row, printed by a source the pack cites (schema\nversion 8, HB-17): the sentence that pairs the two, verbatim, by locator.",
   "properties": {
    "alias": {
     "title": "Alias",
     "type": "string"
    },
    "locator": {
     "title": "Locator",
     "type": "string"
    },
