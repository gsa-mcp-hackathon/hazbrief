    },
    "locator": {
     "title": "Locator",
     "type": "string"
    },
    "name": {
     "title": "Name",
     "type": "string"
    },
    "note": {
     "$ref": "#/$defs/PlacardProse"
    },
    "unresolved": {
     "title": "Unresolved",
     "type": "boolean"
    },
    "unresolved_fields": {
     "items": {
      "type": "string"
     },
     "title": "Unresolved Fields",
     "type": "array"
    }
   },
   "required": [
    "keyed_by",
    "adjudicated",
    "unresolved",
    "unresolved_fields",
    "name",
    "guide",
    "locator",
    "note",
    "aliases"
   ],
   "title": "ErgUnnumbered",
