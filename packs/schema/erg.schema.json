  "PackSource": {
   "additionalProperties": false,
   "description": "One held document a pack was parsed from: its corpus doc_id, the sha256 of the\nheld bytes, where in it the pack reads, and its licence as `corpus/sources.yaml`\nrecords it.",
   "properties": {
    "doc_id": {
     "title": "Doc Id",
     "type": "string"
    },
    "licence": {
     "title": "Licence",
     "type": "string"
    },
    "locator": {
     "title": "Locator",
     "type": "string"
