  "ErgIndexEntry": {
   "additionalProperties": false,
   "description": "Every ID number in the yellow index, seed or not (schema version 2). `in_table1`:\nTable 1 lists the ID number, which covers both TIH materials and water-reactive\nmaterials listed \"(when spilled in water)\" (ERG 2024 PDF p. 30, printed p. 28, Note\n1); which names under the ID it lists is read only for the seeds\n(`ErgMaterial.table1`).",
   "properties": {
    "in_table1": {
     "title": "In Table1",
     "type": "boolean"
    },
    "names": {
     "items": {
      "$ref": "#/$defs/ErgIndexName"
     },
     "title": "Names",
     "type": "array"
    },
    "table1_locator": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Table1 Locator"
    },
    "un": {
     "title": "Un",
     "type": "string"
    }
   },
   "required": [
    "un",
    "names",
    "in_table1",
    "table1_locator"
   ],
   "title": "ErgIndexEntry",
   "type": "object"
  },
  "ErgIndexName": {
   "additionalProperties": false,
   "description": "One yellow-index row: a name and the guide printed beside it.",
