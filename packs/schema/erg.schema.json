     "title": "Quote",
     "type": "string"
    }
   },
   "required": [
    "alias",
    "quote",
    "locator"
   ],
   "title": "ErgNameAlias",
   "type": "object"
  },
  "ErgPlacard": {
   "additionalProperties": false,
   "description": "One input of the placard entry point (schema version 7, HB-15): a placard the\nERG's Table of Markings, Labels and Placards and Initial Response Guide draws (PDF\npp. 10-11, printed pp. 8-9), with the guide circled beside it. \"USE THIS TABLE ONLY\nIF MATERIALS CANNOT BE SPECIFICALLY IDENTIFIED\" (p. 10).\n\n`placard` is the row's key: the hazard class or division (for Classes 2, 4, 5 and\n6, the division ERG p. 8 names for the placard's printed word), a placard word\nwhere one placard of a class has its own guide (OXYGEN, GASOLINE, FUEL OIL, HOT),\nthe lithium battery labels, DANGEROUS, or `none` (no placard can be seen). `words`\nare the other words printed on the row's placards, each also accepted;\n`hazard_class` the class number printed in the placard's lower corner, or None.\n`association`: `prose` when an ERG sentence (`prose`) states the guide as well as\nthe drawing, `drawing` when only the drawing's grouping does. Keyed by A (the PDF\ntext layer: the circled number, and the prose) and B (a reading of the rendered\npage); see packs/SCHEMA.md.",
   "properties": {
    "adjudicated": {
     "title": "Adjudicated",
     "type": "boolean"
    },
    "association": {
     "enum": [
      "prose",
      "drawing"
     ],
     "title": "Association",
     "type": "string"
    },
    "guide": {
     "title": "Guide",
     "type": "string"
    },
    "hazard_class": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Hazard Class"
    },
    "keyed_by": {
     "items": {
      "enum": [
       "A",
       "B",
       "C"
      ],
      "type": "string"
     },
     "title": "Keyed By",
     "type": "array"
    },
    "locator": {
     "title": "Locator",
     "type": "string"
    },
    "placard": {
     "title": "Placard",
     "type": "string"
    },
    "prose": {
     "anyOf": [
      {
       "$ref": "#/$defs/PlacardProse"
      },
      {
       "type": "null"
      }
     ]
    },
    "shows": {
     "title": "Shows",
     "type": "string"
    },
    "unresolved": {
     "title": "Unresolved",
     "type": "boolean"
    },
    "unresolved_fields": {
     "items": {
      "type": "string"
     },
     "title": "Unresolved Fields",
     "type": "array"
    },
    "words": {
     "items": {
      "type": "string"
     },
     "title": "Words",
     "type": "array"
    }
   },
   "required": [
    "keyed_by",
    "adjudicated",
    "unresolved",
    "unresolved_fields",
    "placard",
    "words",
    "hazard_class",
    "shows",
    "guide",
    "locator",
    "association",
    "prose"
   ],
   "title": "ErgPlacard",
   "type": "object"
  },
  "ErgUnnumbered": {
   "additionalProperties": false,
   "description": "A yellow-index row with no ID number (schema version 8, HB-17): ERG 2024 PDF\np. 31 prints four, the explosives, which the index lists by name and division\nbecause \"Explosives are not individually listed by their ID number\" (`note`,\np. 30). A\n`material` matching `name` or an alias resolves to `guide`. Keyed as every index\nrow is (A, B, C).",
