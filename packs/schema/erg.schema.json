   "type": "object"
  },
  "CrossCheck": {
   "additionalProperties": false,
   "description": "One field compared across sources (DN-003 section 5). `values` maps each source\nrole to its value as that source prints it, or None where the source does not carry\nthe field. `agree`: every carrying source agrees and at least two carry it;\n`disputed`: two carrying sources differ; `single_source`: only one source carries\nit.",
   "properties": {
    "field": {
     "title": "Field",
     "type": "string"
    },
    "status": {
     "enum": [
      "agree",
      "disputed",
      "single_source"
     ],
     "title": "Status",
     "type": "string"
    },
    "values": {
     "additionalProperties": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "title": "Values",
     "type": "object"
    }
   },
   "required": [
    "field",
    "values",
    "status"
   ],
   "title": "CrossCheck",
   "type": "object"
  },
