# What the SCICHEM build fetches, pinned (HB-167 Part B item 7). deploy/models/scichem/fetch_source.sh reads this file;
# deploy/models/Dockerfile's ARG defaults must equal it (tests/test_hb167_scichem_image.py holds them equal).
#
# EPRI's SCICHEM repository at the commit HB-165 built and measured (docs/evidence/hb165/fetched.tsv):
SCICHEM_REPO=https://github.com/epri-dev/SCICHEM.git
SCICHEM_COMMIT=156625eff47923d232dbe4f6d055707ea3bf6ff1
# The one data file a run reads (HB-165: with only it mounted the output was byte-identical), stored in Git LFS, so it is
# fetched outside git from GitHub's LFS media host at the same commit and checked by its sha256 (HB-165's copy).
SCICHEM_LANDUSE_URL=https://media.githubusercontent.com/media/epri-dev/SCICHEM/156625eff47923d232dbe4f6d055707ea3bf6ff1/sciData/landuse_scichem.dat
SCICHEM_LANDUSE_SHA256=a4c8c155abf9f750ba0590c1b77331f1e0d0b71e478ece8eceed378a8c5b8434
